{
	"name": "omnioffloader",
	"version": "0.1.6",
	"description": "Offload WordPress media to Amazon S3, Cloudflare R2, Wasabi or any S3-compatible storage, serve it from a CDN, and restore it anytime with Bring Back.",
	"author": "Huzaifa Al Mesbah",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"check-types": "tsc --noEmit",
		"lint:js": "wp-scripts lint-js src",
		"bundle": "node scripts/bundle.js",
		"bundle:org": "node scripts/bundle.js --org",
		"screenshots": "node scripts/capture-screenshots.js"
	},
	"devDependencies": {
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@wordpress/scripts": "^34.0.0",
		"puppeteer-core": "^25.12.0",
		"typescript": "^5.7.0"
	},
	"dependencies": {
		"@wordpress/api-fetch": "^7.52.0",
		"@wordpress/components": "^38.0.0",
		"@wordpress/element": "^8.4.0",
		"@wordpress/i18n": "^6.25.0",
		"@wordpress/icons": "^15.4.0",
		"@wordpress/url": "^4.52.0"
	},
	"packageManager": "pnpm@12.4.2"
}
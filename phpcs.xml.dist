<?xml version="1.0"?>
<ruleset name="OmniOffloader">
	<description>WordPress Coding Standards for OmniOffloader.</description>

	<file>omnioffloader.php</file>
	<file>uninstall.php</file>
	<file>includes</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<!-- Vendored library (Delicious Brains WP_Background_Processing), kept close to upstream. -->
	<exclude-pattern>*/includes/Abstracts/*</exclude-pattern>

	<arg value="sp"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>

	<config name="minimum_wp_version" value="6.6"/>

	<!-- PHP compatibility across every supported version (Requires PHP 8.1, no
	     upper bound), as wordpress-develop and Gutenberg do. PHPCompatibilityWP
	     knows the polyfills WordPress ships, so it doesn't flag those. -->
	<config name="testVersion" value="8.1-"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress">
		<!-- Short array syntax is used throughout this project. -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
		<!-- PSR-4 style class files, per architecture. -->
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="omnioffloader"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="omnioffloader"/>
				<element value="OMNIOFFLOADER"/>
				<element value="OmniOffloader"/>
			</property>
		</properties>
	</rule>
</ruleset>

"cues": [
{
"start": 0.096,
"end": 4.543,
"text": "Under Behavior, Background Cloud Offload keeps your uploads fast."
},
{
"start": 4.543,
"end": 7.801,
"text": "Transfer Speed sets how many files move at once:"
},
{
"start": 7.801,
"end": 10.168,
"text": "Low for small shared hosting, Balanced for most"
},
{
"start": 10.168,
"end": 13.498,
"text": "sites, and Fast or Custom for a VPS."
},
{
"start": 13.498,
"end": 15.889,
"text": "Mirror Delete removes the cloud copy"
},
{
"start": 15.889,
"end": 18.522,
"text": "when you delete media in WordPress."
},
{
"start": 18.522,
"end": 21.094,
"text": "A custom path prefix stores your files in"
},
{
"start": 21.094,
"end": 23.702,
"text": "a folder of your choice, and Object Versioning"
},
{
"start": 23.702,
"end": 26.899,
"text": "stops CDN caches from serving stale files."
},
{
"start": 26.899,
"end": 28.68,
"text": "Then click Save changes."
}
]

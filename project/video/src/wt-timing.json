"cues": [
{
"start": 0.084,
"end": 2.668,
"text": "Next, serving media from your CDN."
},
{
"start": 2.668,
"end": 4.399,
"text": "Enter your custom domain:"
},
{
"start": 4.399,
"end": 8.918,
"text": "the public address that serves your bucket, like media.yourdomain.com."
},
{
"start": 8.918,
"end": 11.779,
"text": "Most buckets aren't public by default, and Cloudflare R2"
},
{
"start": 11.779,
"end": 14.123,
"text": "has no public address until you connect a custom"
},
{
"start": 14.123,
"end": 17.248,
"text": "domain, or turn on its r2.dev URL."
},
{
"start": 17.248,
"end": 20.048,
"text": "Once media is offloaded, URLs are"
},
{
"start": 20.048,
"end": 22.284,
"text": "rewritten as your pages render:"
},
{
"start": 22.284,
"end": 26.238,
"text": "images, srcset, galleries, video and audio."
},
{
"start": 26.238,
"end": 28.488,
"text": "Nothing in your database is changed."
}
]

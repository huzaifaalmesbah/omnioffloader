"cues": [
{
"start": 0.084,
"end": 1.394,
"text": "Not ready to switch yet?"
},
{
"start": 1.394,
"end": 3.173,
"text": "With Retain Local Files, turn"
},
{
"start": 3.173,
"end": 5.024,
"text": "off Serve Media from Cloud."
},
{
"start": 5.024,
"end": 7.656,
"text": "Your media is still offloaded as a backup, but"
},
{
"start": 7.656,
"end": 10.156,
"text": "your site keeps loading it from your own server."
},
{
"start": 10.156,
"end": 12.26,
"text": "When your CDN is ready, turn it back on"
},
{
"start": 12.26,
"end": 15.577,
"text": "and save, and every page switches right away."
},
{
"start": 15.577,
"end": 17.784,
"text": "Just clear your page cache afterwards."
}
]

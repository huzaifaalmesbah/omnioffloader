"end": 5.06,
"text": "retention policy to media you already offloaded."
},
{
"start": 5.06,
"end": 8.269,
"text": "Before any local copy is deleted, every file"
},
{
"start": 8.269,
"end": 10.445,
"text": "is checked in the cloud, by size."
},
{
"start": 10.445,
"end": 12.031,
"text": "Changed your path prefix?"
},
{
"start": 12.031,
"end": 15.469,
"text": "Move Media copies older files into the current folder,"
},
{
"start": 15.469,
"end": 18.528,
"text": "right inside your bucket, so nothing is downloaded."
}

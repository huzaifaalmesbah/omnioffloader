{
"start": 0.096,
"end": 2.837,
"text": "Open Settings and choose your provider:"
},
{
"start": 2.837,
"end": 7.488,
"text": "Amazon S3, Cloudflare R2, DigitalOcean Spaces, Backblaze"
},
{
"start": 7.488,
"end": 12.464,
"text": "B2, Wasabi, or any S3-compatible storage."
},
{
"start": 12.464,
"end": 14.796,
"text": "Enter your access key, secret and"
},
{
"start": 14.796,
"end": 17.488,
"text": "bucket name, then click Test Connection."
},
{
"start": 17.488,
"end": 19.772,
"text": "When you see Connected, you're ready."
},
{
"start": 19.772,
"end": 20.962,
"text": "You can also keep your keys out of"
},
{
"start": 20.962,
"end": 25.464,

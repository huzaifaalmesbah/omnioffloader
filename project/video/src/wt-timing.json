"cues": [
{
"start": 0.084,
"end": 3.69,
"text": "Have a large library, five thousand items or more?"
},
{
"start": 3.69,
"end": 6.106,
"text": "We recommend WP-CLI."
},
{
"start": 6.106,
"end": 7.861,
"text": "There's no browser and no web time"
},
{
"start": 7.861,
"end": 9.832,
"text": "limit, and with the concurrency option it"
},
{
"start": 9.832,
"end": 12.825,
"text": "uploads up to sixty-four files at once."
},
{
"start": 12.825,
"end": 14.507,
"text": "Start it in the background, watch its"
},
{
"start": 14.507,
"end": 16.418,
"text": "log, and check the speed and time"
},
{
"start": 16.418,
"end": 18.077,
"text": "left with the status command."
},
{
"start": 18.077,
"end": 19.507,
"text": "While it runs, the admin"
},
{
"start": 19.507,
"end": 21.695,
"text": "screens show its progress too."
},
{
"start": 21.695,
"end": 24.171,
"text": "Stop it anytime with the stop command,"
},
{
"start": 24.171,
"end": 25.877,
"text": "then run the same command again to"
},
{
"start": 25.877,
"end": 27.456,
"text": "continue where it left off."
}
]
},

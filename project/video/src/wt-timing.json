"cues": [
{
"start": 0.084,
"end": 2.019,
"text": "Bring Back reverses everything."
},
{
"start": 2.019,
"end": 4.952,
"text": "Open the Bring Back page and check the preflight:"
},
{
"start": 4.952,
"end": 8.149,
"text": "the estimated download, and your free disk space."
},
{
"start": 8.149,
"end": 10.541,
"text": "Choose all media or a custom amount."
},
{
"start": 10.541,
"end": 13.089,
"text": "Keep Cloud Copies is recommended, and deleting"
},
{
"start": 13.089,
"end": 15.361,
"text": "from the cloud only happens after every"
},
{
"start": 15.361,
"end": 17.464,
"text": "file is verified on your server."
},
{
"start": 17.464,
"end": 20.325,
"text": "Click Start Bring Back, and follow the progress."
},
{
"start": 20.325,
"end": 21.803,
"text": "Using a cleanup policy?"
},
{
"start": 21.803,
"end": 25.144,
"text": "Always run Bring Back before you deactivate the plugin."
},
{
"start": 25.144,
"end": 27.043,
"text": "And for a large library, use"
},
{
"start": 27.043,
"end": 29.472,
"text": "the restore command in WP-CLI."
}
]
},

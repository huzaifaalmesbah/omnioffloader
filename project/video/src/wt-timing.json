"cues": [
{
"start": 0.096,
"end": 2.175,
"text": "Now choose a retention policy."
},
{
"start": 2.175,
"end": 5.312,
"text": "Retain Local Files keeps everything on your server,"
},
{
"start": 5.312,
"end": 7.188,
"text": "and it's the safest place to start."
},
{
"start": 7.188,
"end": 9.519,
"text": "Smart Local Cleanup deletes the generated"
},
{
"start": 9.519,
"end": 12.392,
"text": "thumbnails, and keeps your originals."
},
{
"start": 12.392,
"end": 15.685,
"text": "Full Cloud Migration removes every local copy,"
},
{
"start": 15.685,
"end": 18.077,
"text": "to free the most disk space."
},
{
"start": 18.077,
"end": 20.373,
"text": "A local file is never deleted until"
},
{
"start": 20.373,
"end": 22.656,
"text": "its upload is confirmed in your bucket."
}
]

"cues": [
{
"start": 0.096,
"end": 3.57,
"text": "This is OmniOffloader, a free WordPress plugin that"
},
{
"start": 3.57,
"end": 6.526,
"text": "moves your media library to cloud storage, serves"
},
{
"start": 6.526,
"end": 8.45,
"text": "it from your own CDN, and lets you"
},
{
"start": 8.45,
"end": 9.94,
"text": "bring it all back anytime."
},
{
"start": 9.94,
"end": 12.788,
"text": "In this walkthrough, we'll install it, connect a bucket,"
},
{
"start": 12.788,
"end": 15.432,
"text": "and go through every feature, one by one."
}
]
},
